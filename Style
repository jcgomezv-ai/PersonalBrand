* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    background: #f7f7f5;
    color: #111111;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}


/* NAVIGATION */

.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(247, 247, 245, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #ddddda;
}

.nav-container {
    max-width: 1200px;
    margin: auto;
    padding: 20px 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: #635bff;
}

nav {
    display: flex;
    gap: 28px;
}

nav a {
    font-size: 14px;
    font-weight: 500;
    color: #555;
    transition: 0.2s;
}

nav a:hover {
    color: #635bff;
}


/* HERO */

.hero {
    min-height: 100vh;
    max-width: 1200px;
    margin: auto;
    padding: 160px 30px 100px;

    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 80px;
    align-items: center;
}

.eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #635bff;
    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(50px, 7vw, 88px);
    line-height: 0.98;
    letter-spacing: -5px;
    max-width: 850px;
}

.hero h1 span {
    color: #635bff;
}

.hero-description {
    max-width: 650px;
    margin-top: 30px;

    font-size: 18px;
    color: #666;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 40px;
}

.btn {
    padding: 14px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s;
}

.btn.primary {
    background: #111;
    color: white;
}

.btn.primary:hover {
    transform: translateY(-2px);
}

.btn.secondary {
    border: 1px solid #ccccca;
}

.btn.secondary:hover {
    border-color: #635bff;
    color: #635bff;
}


/* HERO CARD */

.hero-card {
    background: #111;
    color: white;
    padding: 40px;
    border-radius: 20px;

    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.12);
}

.card-header {
    color: #aaa;
    font-size: 13px;

    display: flex;
    align-items: center;
    gap: 8px;
}

.status-dot {
    width: 8px;
    height: 8px;
    background: #6ee7b7;
    border-radius: 50%;
}

.hero-card h3 {
    font-size: 34px;
    line-height: 1.1;
    margin: 35px 0 50px;
}

.mini-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.mini-stats div {
    display: flex;
    flex-direction: column;
}

.mini-stats strong {
    font-size: 20px;
}

.mini-stats span {
    font-size: 11px;
    color: #888;
}


/* GENERAL SECTIONS */

.section {
    max-width: 1200px;
    margin: auto;
    padding: 130px 30px;
}

.section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #635bff;
    margin-bottom: 40px;
}

.section h2 {
    font-size: clamp(40px, 5vw, 65px);
    line-height: 1;
    letter-spacing: -3px;
}


/* ABOUT */

.about-grid {
    margin-top: 70px;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
}

.about-text {
    font-size: 18px;
    color: #555;
}

.about-text p {
    margin-bottom: 25px;
}


/* DARK SECTION */

.dark-section {
    max-width: none;
    padding-left: max(30px, calc((100vw - 1140px) / 2));
    padding-right: max(30px, calc((100vw - 1140px) / 2));

    background: #111;
    color: white;
}

.dark-section .section-label {
    color: #8f88ff;
}


/* TIMELINE */

.timeline {
    margin-top: 80px;
}

.timeline-item {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 40px;

    padding: 45px 0;
    border-top: 1px solid #333;
}

.timeline-date {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #777;
}

.timeline-content h3 {
    font-size: 27px;
    margin-bottom: 5px;
}

.timeline-content h4 {
    font-size: 14px;
    color: #8f88ff;
    margin-bottom: 20px;
}

.timeline-content p {
    max-width: 700px;
    color: #aaa;
}


/* TAGS */

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 25px;
}

.tags span {
    padding: 6px 10px;

    border: 1px solid #ddd;
    border-radius: 100px;

    font-size: 11px;
    font-weight: 600;
}

.dark-section .tags span {
    border-color: #444;
    color: #bbb;
}


/* SKILLS */

.skills-grid {
    margin-top: 80px;

    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;

    background: #ddd;
    border: 1px solid #ddd;
}

.skill-card {
    background: #f7f7f5;
    padding: 45px;
    min-height: 250px;
}

.skill-number {
    font-size: 11px;
    font-weight: 700;
    color: #635bff;
}

.skill-card h3 {
    font-size: 25px;
    margin: 30px 0 15px;
}

.skill-card p {
    color: #666;
}


/* PROJECTS */

.projects-section {
    background: #e9e9e5;
    max-width: none;
    padding-left: max(30px, calc((100vw - 1140px) / 2));
    padding-right: max(30px, calc((100vw - 1140px) / 2));
}

.projects-header {
    margin-top: 70px;

    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
}

.projects-header p {
    max-width: 400px;
    color: #666;
}

.projects-grid {
    margin-top: 70px;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.project-card {
    background: #f7f7f5;
    padding: 35px;
    min-height: 360px;

    display: flex;
    flex-direction: column;
}

.project-number {
    color: #635bff;
    font-size: 12px;
    font-weight: 700;
}

.project-card h3 {
    font-size: 27px;
    line-height: 1.1;
    margin: 50px 0 20px;
}

.project-card p {
    color: #666;
}

.project-card .tags {
    margin-top: auto;
}


/* CONTACT */

.contact-section {
    text-align: center;
    padding: 150px 30px;

    background: #111;
    color: white;
}

.contact-section .section-label {
    color: #8f88ff;
}

.contact-section h2 {
    max-width: 800px;
    margin: auto;

    font-size: clamp(45px, 6vw, 75px);
    line-height: 1;
    letter-spacing: -4px;
}

.contact-section p {
    max-width: 550px;
    margin: 35px auto;

    color: #aaa;
}

.contact-links {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 45px;
}

.contact-links a {
    color: white;
    font-weight: 600;
    border-bottom: 1px solid #555;
    padding-bottom: 5px;
}

.contact-links a:hover {
    color: #8f88ff;
}


/* FOOTER */

footer {
    background: #111;
    border-top: 1px solid #333;

    padding: 25px 30px;

    display: flex;
    justify-content: space-between;

    color: #777;
    font-size: 11px;
}


/* RESPONSIVE */

@media (max-width: 800px) {

    nav {
        display: none;
    }

    .hero {
        grid-template-columns: 1fr;
        gap: 50px;
    }

    .hero h1 {
        letter-spacing: -3px;
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .timeline-item {
        grid-template-columns: 1fr;
        gap: 15px;
    }

    .skills-grid {
        grid-template-columns: 1fr;
    }

    .projects-header {
        flex-direction: column;
        align-items: start;
    }

    .projects-grid {
        grid-template-columns: 1fr;
    }

    footer {
        flex-direction: column;
        gap: 10px;
    }
}
